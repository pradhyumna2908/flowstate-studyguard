# ==============================================================================
# FlowState StudyGuard - Environment Configuration Template
# Copy this file to .env and configure for your local deployment
# ==============================================================================

# Application & Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
LOG_LEVEL=INFO

# MediaPipe AI Model Assets
MODEL_PATH=face_landmarker.task
MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task

# Study Session Defaults
STUDY_TARGET_MINUTES=45
MIN_STUDY_MINUTES=10
MAX_STUDY_MINUTES=300

# Focus Shield & App Blocker Policies
# Options: minimize, close, alert, disabled
SHIELD_MODE=minimize

# Smart YouTube & Content Filtering Defaults (comma-separated)
CUSTOM_STUDY_TOPICS="math, physics, chemistry, biology, calculus, coding, python, lecture, tutorial, course, cs50, khan academy, one shot, revision, exam, dsa, engineering"
CUSTOM_BLOCK_KEYWORDS="shorts, music, song, trailer, gameplay, meme, vlog, funny, comedy, prank, mrbeast, gaming, netflix, twitch, prime video, steam, discord, vlc"

# Biometric & Multi-Modal Thresholds
FRAME_SKIP=3
DISTRACTION_THRESHOLD=0.35
SCREEN_FLASH_RMSD_THRESHOLD=3.8
BLINK_RATE_SUPPRESSION_THRESHOLD=6.0
KEYBOARD_MOUSE_IDLE_SECONDS=90.0

# Parent Mobile Dashboard & Direct Messaging Integration
PARENT_PHONE_NUMBER="+91 9876543210"
ENABLE_PARENT_NUDGES=true
ENABLE_LOCAL_NETWORK_SHARING=true
AUTO_ALERT_DISTRACTIONS=true
AUTO_ALERT_COMPLETION=true

# Direct Messaging Gateway Settings (Optional for Direct Cloud Dispatch)
# Supported Providers: Twilio SMS / WhatsApp, CallMeBot WhatsApp, Fast2SMS, Custom Webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CALLMEBOT_API_KEY=
FAST2SMS_API_KEY=
SMS_WEBHOOK_URL=

# Audio Activity Monitoring
ENABLE_AUDIO_CROSS_CHECKING=true
